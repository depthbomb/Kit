<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net48</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <RootNamespace>Kit.Updater</RootNamespace>
        <AssemblyName>updater</AssemblyName>
        <IsPackable>false</IsPackable>
        <Company>Caprine Logic</Company>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <Deterministic>false</Deterministic>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="System.IO.Compression" />
        <Reference Include="System.IO.Compression.FileSystem" />
        <Reference Include="System.Net.Http" />
        <Reference Include="System.Web.Extensions" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\Shared\UpdaterConfiguration.cs">
          <Link>Shared\UpdaterConfiguration.cs</Link>
        </Compile>
        <Compile Include="..\Shared\StampPayload.cs" Link="Shared\StampPayload.cs" />
        <Compile Update="Forms\MainForm.cs">
            <SubType>Form</SubType>
        </Compile>
        <Compile Update="Forms\UpdatePromptForm.cs" />
    </ItemGroup>
</Project>
