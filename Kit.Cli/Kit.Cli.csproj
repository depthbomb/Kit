<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>false</PublishAot>
        <AssemblyName>kit</AssemblyName>
        <Company>Caprine Logic</Company>
        <ApplicationIcon>..\assets\icon.ico</ApplicationIcon>
        <AssemblyVersion>0.2.1</AssemblyVersion>
        <FileVersion>0.2.1</FileVersion>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\Shared\UpdaterConfiguration.cs" Link="Shared\UpdaterConfiguration.cs"/>
        <Compile Include="..\Shared\StampPayload.cs" Link="Shared\StampPayload.cs" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\assets\icon.ico">
        <Link>icon.ico</Link>
      </None>
    </ItemGroup>
</Project>
